{
  "name": "@dreamer/test",
  "version": "1.2.1",
  "description": "A testing utility library compatible with Deno, Bun, and Node.js: mock tools, assertion enhancements, test utilities, and browser test integration.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shuliangfu/test.git"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./browser": "./src/browser/mod.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:node": "tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "test:node:browser": "tsx --tsconfig tsconfig.json --test --test-concurrency=1 tests/browser/*.test.ts",
    "test:node:all": "npm run test:node && npm run test:node:browser"
  },
  "dependencies": {
    "@dreamer/esbuild": "npm:@jsr/dreamer__esbuild@^1.2.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@1.0.1",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.0.3",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.1",
    "playwright": "1.59.1"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "keywords": [
    "test",
    "testing",
    "deno",
    "bun",
    "node",
    "nodejs",
    "mock",
    "assertion",
    "playwright",
    "browser-test"
  ]
}
